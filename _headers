# Security headers for every response. X-Frame-Options: DENY is safe because
# nothing frames our own pages: the only iframes we create (claude-studio.js)
# use srcdoc, and OAuth flows use window.open popups, not frames.
# CSP is Report-Only on purpose: it logs violations in the browser console
# without blocking anything. Tighten and enforce only after reviewing reports.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src https:; media-src 'self' blob: https:; object-src 'none'; base-uri 'self'

# Netlify caching. HTML must always revalidate; versioned assets can be cached
# for a year because their URL changes (?v=... or a new file) when they change.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
